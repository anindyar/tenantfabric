# Copy to .env (git-ignored) and replace every value before exposing tenantfabric anywhere.
#   Compose reads .env automatically:      docker compose up -d
#   Kubernetes:                            python3 scripts/render-k8s.py .env > tenantfabric.local.yaml
#                                          kubectl apply -f tenantfabric.local.yaml
# New key:      python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# New password: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# One key per team (and memsvc's own key, used only for embeddings).
TF_KEY_ALPHA=
TF_KEY_BETA=
TF_KEY_MEMSVC=

# Postgres superuser (gateway request logs) and the non-owner role memsvc uses (row-level security applies to it).
TF_POSTGRES_PASSWORD=
TF_MEMSVC_DB_PASSWORD=

# alpha's CLI runner credentials: least-privilege, short-lived.
ALPHA_AWS_ACCESS_KEY_ID=
ALPHA_AWS_SECRET_ACCESS_KEY=
ALPHA_AWS_DEFAULT_REGION=us-east-1

# Host port for the gateway (Compose only).
GATEWAY_PORT=8080
